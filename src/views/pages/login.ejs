<section class="rlt-section rlt-login">
  <div class="rlt-container rlt-login__inner">
    <div class="md-card md-card--outlined rlt-login__card">
      <div class="md-card__content">
        <%- include('partials/section-header', { eyebrow: '', headline: content.headline, supporting: content.supporting, align: 'center', level: 1 }) %>
        <%- include('partials/form', { form: content.form, inline: false, submitColor: 'primary' }) %>
        <ul class="rlt-login__links md-body-medium">
<% (content.links || []).forEach((link) => { %>
          <li><a href="<%= link.href %>"><%= link.label %></a></li>
<% }); %>
        </ul>
      </div>
    </div>
  </div>
</section>
